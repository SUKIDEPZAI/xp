# Runtime configuration. Keep real values out of Git and frontend bundles.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Neon: use the pooled connection string (hostname includes -pooler) for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct, unpooled connection for migrations and maintenance only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DB?sslmode=require

# Required for account/session APIs; replace with a random value of at least 32 bytes.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

